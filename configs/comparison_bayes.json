{
  "schema_version": 1,
  "experiment": {
    "name": "cifar10_bayesian_sampling",
    "output_dir": "results"
  },
  "fixed": {
    "task": "cifar10",
    "llm_name": "llama-3.1-8B-Instruct",
    "fast_llm_name": "llama-3.1-8B-Instruct",
    "edit_script_llm_name": "llama-3.1-8B-Instruct",
    "agent_type": "ResearchAgent",
    "max_steps": 30,
    "max_time": 18000,
    "device": 0
  },
  "search": {
    "method": "bayesian",
    "sampler": {
      "name": "tpe",
      "seed": 42
    },
    "n_initial": 6,
    "n_iter": 12,
    "space": {
      "top_p": {
        "type": "float",
        "low": 0.7,
        "high": 1.0
      },
      "temperature": {
        "type": "float",
        "low": 0.2,
        "high": 0.7
      }
    },
    "enqueue": [
      {
        "top_p": 0.9,
        "temperature": 0.7
      }
    ]
  },
  "objective": {
    "metric": "final_score",
    "direction": "maximize",
    "run_aggregation": "mean",
    "behavioral_failure": {
      "policy": "penalty",
      "value": 0.0
    }
  },
  "execution": {
    "runs_per_trial": 1,
    "subprocess_timeout_seconds": 18300,
    "continue_on_trial_failure": true
  },
  "persistence": {
    "resume": true,
    "require_sampler_state_on_resume": true
  },
  "tracking": {
    "codecarbon": true
  }
}
