        X_dataset.append(img)

    X = np.array(X_dataset)
    y = np.array(train_df["categories"].to_list())

    X_train, X_test, y_train, y_test = train_test_split(
        X, y, random_state=20, test_size=0.3
    )

    # Definir modelo CNN simple
