# Dedicated-L40S high-throughput preset. This requires at least two physical
# GPUs: L40S 0 serves vLLM and L40S 1 runs benchmark training. Do not point both
# IDs at one GPU while using the 0.85 vLLM memory reservation.
#
# Copy this file outside the repository and pass it with --env-file.
# See BREV_BAYESIAN_GUIDE.md. Do not put the token itself in this file.

COMPOSE_PROJECT_NAME=mlagentbench-brev
MLAGENTBENCH_IMAGE=mlagentbench-thesis:brev

# Everything below this host directory survives container recreation. On Brev,
# /home/ubuntu/workspace also survives an instance stop (but not deletion).
BREV_STORAGE_ROOT=/home/ubuntu/workspace/cc2026-data

# This file must contain only the Hugging Face token. Compose mounts it as a
# secret and exposes only its path to huggingface_hub inside the vLLM service.
HF_TOKEN_FILE=/home/ubuntu/workspace/.secrets/huggingface-token

# The optimizer loads this path inside /MLAgentBench. An absolute path below
# /data is also valid for a private or temporary experiment config.
BAYES_CONFIG=configs/comparison_bayes.json
OPTIMIZER_RESTART_POLICY=on-failure:3

VLLM_MODEL_ID=meta-llama/Llama-3.1-8B-Instruct
VLLM_SERVED_MODEL_NAME=llama-3.1-8B-Instruct

# Keep inference and benchmark training on different physical GPUs.
VLLM_GPU_ID=0
OPTIMIZER_GPU_ID=1

# High-throughput starting point for a dedicated 48 GB L40S. The current
# Bayesian controller is sequential, so 16384 is a better initial token budget
# than 32768. Load-test 32768 only when adding substantial concurrent traffic.
VLLM_GPU_MEMORY_UTILIZATION=0.85
VLLM_MAX_MODEL_LEN=8192
VLLM_MAX_NUM_SEQS=32
VLLM_MAX_NUM_BATCHED_TOKENS=16384
VLLM_HEALTH_START_PERIOD=600s

# The API binds to loopback by default. Use 0.0.0.0 only if remote access is
# necessary and the Brev/network firewall is configured appropriately.
VLLM_BIND_ADDRESS=127.0.0.1
VLLM_HOST_PORT=8002

CONTAINER_SHM_SIZE=16gb
