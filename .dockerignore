# Ignorar resultados de experimentos locales
user1_*/
userN_*/
output_exel/
mis_multi_plots/
mis_multi_plotsN/
JMETER/

# Cachés y basura típica
__pycache__/
*.pyc
*.log

# Datos pesados que se pueden volver a descargar
data/
MLAgentBench/benchmarks/*/env/data/
networks/

# Git y cosas de IDE
.git
.gitignore
.vscode/
.idea/

# Credenciales y configuración local: nunca deben entrar en una capa COPY.
.env
.env.*
!.env.brev.example
.kaggle/
**/.kaggle/
.secrets/

# Artefactos persistentes montados por los runners/Compose.
results/
logs/
workspace/
